<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <RootNamespace>DragonDen_Euphoria</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <Version>2.0.0</Version>
        <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <Title>DragonDen-Euphoria</Title>
        <Authors>Drexira</Authors>
        <PackageProjectUrl>https://forge.sp-tarkov.com/mod/2330/dragon-den-euphoria</PackageProjectUrl>
        <PackageLicenseUrl>https://github.com/Drexira/DragonDen-Euphoria/blob/SPT-4.0/LICENSE</PackageLicenseUrl>
        <RepositoryUrl>https://github.com/Drexira/DragonDen-Euphoria</RepositoryUrl>
        <RepositoryType>Github</RepositoryType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <ModsBaseDir>D:\SP-AKI\Drexira\4.0\!Releases\DragonDen-Euphoria\SPT\user\mods</ModsBaseDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'!='Release'">
        <ModsBaseDir>C:\SPT\SPT 4.0\SPT\user\mods</ModsBaseDir>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SPTarkov.Common" Version="4.0.2-pre.202510202154" />
        <PackageReference Include="SPTarkov.DI" Version="4.0.2-pre.202510202154" />
        <PackageReference Include="SPTarkov.Server.Core" Version="4.0.2-pre.202510202154" />

        <Reference Include="WTTServerCommonLib">
            <HintPath>C:\SPT\SPT 4.0\SPT\user\mods\WTT-ServerCommonLib\WTT-ServerCommonLib.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Update="bundles.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>

        <Content Include="bundles\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Command="set MODNAME=$(AssemblyName)&#x0A;set DLLPATH=$(TargetDir)$(AssemblyName).dll&#x0A;set OUTDIR=$(ModsBaseDir)\$(AssemblyName)&#x0A;if not exist &quot;%OUTDIR%&quot; mkdir &quot;%OUTDIR%&quot;&#x0A;copy /Y &quot;%DLLPATH%&quot; &quot;%OUTDIR%\&quot;&#x0A;if exist &quot;$(TargetDir)bundles.json&quot; copy /Y &quot;$(TargetDir)bundles.json&quot; &quot;%OUTDIR%\&quot;&#x0A;if not exist &quot;%OUTDIR%\db&quot; mkdir &quot;%OUTDIR%\db&quot;&#x0A;if exist &quot;$(ProjectDir)db\*&quot; xcopy &quot;$(ProjectDir)db\*&quot; &quot;%OUTDIR%\db\&quot; /E /I /Y&#x0A;if not exist &quot;%OUTDIR%\bundles&quot; mkdir &quot;%OUTDIR%\bundles&quot;&#x0A;if exist &quot;$(ProjectDir)bundles\*&quot; xcopy &quot;$(ProjectDir)bundles\*&quot; &quot;%OUTDIR%\bundles\&quot; /E /I /Y" />
    </Target>

</Project>
